{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 24, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": false
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{namespace=\"$namespace\", app=~\"$app\"} |= \"$search\" | json | line_format \"{{.log_level}} {{.method}} {{.path}} → {{.message}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs · $namespace / $app",
      "type": "logs"
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["logs", "loki", "json"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Loki",
        "name": "DS_LOKI",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": { "text": "app", "value": "app" },
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "includeAll": false,
        "label": "Namespace",
        "name": "namespace",
        "options": [],
        "query": "label_values(namespace)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "includeAll": true,
        "label": "App",
        "multi": true,
        "name": "app",
        "options": [],
        "query": "label_values({namespace=\"$namespace\"}, app)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "label": "Search",
        "name": "search",
        "options": [{ "selected": true }],
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Logs · JSON (ECS)",
  "uid": "logs-json-ecs",
  "version": 2
}
